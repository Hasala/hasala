{
  "name": "hasala-aasa",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  },
  "routes": [{ "pattern": "hasala.app/*", "zone_name": "hasala.app" }],
  "workers_dev": false,
  "preview_urls": true,
  "previews": {},
  "observability": { "enabled": false },
  "send_metrics": false
}
